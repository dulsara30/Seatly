# Copy to backend/.env and fill in. backend/.env is git-ignored; this
# template is committed so every key the backend needs is documented.
#
# Imported by application.yml (spring.config.import). Real environment
# variables override anything here — which is how CI and production set them.

# Signs and verifies JWT access tokens. Base64, at least 32 random bytes.
# Generate one with:  openssl rand -base64 32
# Changing it logs everyone out: existing tokens stop verifying.
JWT_SIGNING_KEY=
